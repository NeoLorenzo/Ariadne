{
  "name": "ariadne",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check:privacy": "node scripts/privacy-check.mjs",
    "check:undefined": "eslint app components lib",
    "test": "npm run check:undefined && vitest run",
    "dev": "next dev",
    "dev:reset": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev",
    "dev:stable": "set WATCHPACK_POLLING=true&& set CHOKIDAR_USEPOLLING=1&& next dev",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.10",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
