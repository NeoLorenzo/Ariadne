{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "0.4.0",
  "status": "implementation-baseline",
  "referenceFrame": {
    "desktopWidth": "1440px",
    "desktopHeight": "720px",
    "note": "Reference composition originated from the approved Figma desktop example. The production desktop shell may expand responsively up to a 1680px maximum width with 80px internal gutters. Explicit typography values are authoritative."
  },
  "color": {
    "background": "#000000",
    "surface": "#000000",
    "textPrimary": "#FFFFFF",
    "textSecondary": "#D0D0D0",
    "textMuted": "#A0A0A0",
    "border": "#252525",
    "borderStrong": "#7F7F7F"
  },
  "typography": {
    "familyPrimary": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "productHeader": {
      "fontFamily": "Inter",
      "fontWeight": 600,
      "fontSize": "36px",
      "lineHeight": 1,
      "letterSpacing": "0.35em",
      "source": "figma"
    },
    "heroTitle": {
      "fontFamily": "Inter",
      "fontWeight": 900,
      "fontSize": "64px",
      "lineHeight": 1.12,
      "letterSpacing": "0.20em",
      "textTransform": "uppercase",
      "source": "figma"
    },
    "heroSubtitle": {
      "fontFamily": "Inter",
      "fontWeight": 400,
      "fontSize": "32px",
      "lineHeight": 1.3,
      "letterSpacing": "0",
      "source": "figma"
    },
    "logoCaption": {
      "fontFamily": "Inter",
      "fontWeight": 600,
      "fontSize": "24px",
      "lineHeight": 1,
      "letterSpacing": "0.40em",
      "textTransform": "uppercase",
      "source": "figma"
    },
    "nav": {
      "fontFamily": "Inter",
      "fontWeight": 600,
      "fontSize": "14px",
      "lineHeight": 1,
      "letterSpacing": "0",
      "source": "inferred"
    },
    "button": {
      "fontFamily": "Inter",
      "fontWeight": 600,
      "fontSize": "16px",
      "lineHeight": 1,
      "letterSpacing": "0",
      "source": "inferred"
    },
    "body": {
      "fontFamily": "Inter",
      "fontWeight": 400,
      "fontSize": "18px",
      "lineHeight": 1.6,
      "letterSpacing": "0",
      "source": "inferred"
    },
    "footer": {
      "fontFamily": "Inter",
      "fontWeight": 500,
      "fontSize": "12px",
      "lineHeight": 1,
      "letterSpacing": "0",
      "source": "inferred"
    },
    "kicker": {
      "fontFamily": "Inter",
      "fontWeight": 600,
      "fontSize": "12px",
      "lineHeight": 1,
      "letterSpacing": "0.18em",
      "textTransform": "uppercase",
      "source": "implementation-baseline"
    }
  },
  "layout": {
    "pageMaxWidth": "1680px",
    "desktopGutter": "80px",
    "headerHeight": "160px",
    "desktopHeroHeight": "480px",
    "footerHeight": "80px",
    "mobileGutter": "24px",
    "tabletGutter": "40px"
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "9": "80px",
    "10": "96px"
  },
  "radius": {
    "small": "6px",
    "control": "8px",
    "large": "12px"
  },
  "border": {
    "width": "1px"
  },
  "control": {
    "heroButtonHeight": "52px",
    "headerButtonHeight": "40px",
    "activeNavHeight": "32px",
    "buttonPaddingInline": "24px",
    "buttonGap": "16px"
  },
  "motion": {
    "fast": "120ms",
    "normal": "180ms",
    "easing": "ease"
  },
  "breakpoint": {
    "mobile": "720px",
    "tablet": "1024px"
  },
  "branding": {
    "applicationFamilyEndorsement": {
      "asset": "Fabbro Systems Logo.svg",
      "treatment": "mark-only",
      "placement": "top-right-application-utility-cluster",
      "desktopSize": "24px",
      "visibleTextLabel": false,
      "orderBeforeSessionAction": true
    }
  },
  "publicShell": {
    "version": "1.0.0",
    "header": {
      "desktopGridColumns": "minmax(220px, 1fr) auto minmax(120px, 1fr)",
      "desktopLockupMaxWidth": "300px",
      "compactBreakpoint": "1200px",
      "compactLockupWidth": "240px",
      "mobileBreakpoint": "720px",
      "mobileGridColumns": "1fr auto",
      "mobileLockupWidth": "min(190px, 54vw)",
      "navigationAlignment": "center",
      "navigationLabels": "product-owned",
      "navigationItemCount": "3-5",
      "familyLinkInPrimaryNavigation": false,
      "signInPlacement": "far-right"
    },
    "focus": {
      "outlineWidth": "2px",
      "outlineStyle": "solid",
      "outlineColor": "#FFFFFF",
      "outlineOffset": "3px"
    },
    "footer": {
      "productLockupWidth": "150px",
      "familyMarkSize": "22px"
    }
  },
  "applicationShell": {
    "desktop": {
      "primaryNavigationPlacement": "left",
      "primaryNavigationBehavior": "persistent",
      "primaryNavigationCollapsible": true,
      "contentPlacement": "right-of-primary-navigation",
      "topUtilityRegionAllowed": true,
      "topUtilityRegionRole": "context-session-family-utilities",
      "topUtilityRegionMayReplacePrimaryNavigation": false,
      "duplicateGlobalPrimaryNavigationInPageContent": false,
      "primaryNavigationComponent": "Fabbro Application Sidebar",
      "primaryNavigationComponentVersion": "1.0.0",
      "primaryNavigationDefaultState": "expanded",
      "primaryNavigationExpandedWidth": "15.5rem",
      "primaryNavigationCollapsedWidth": "4.5rem",
      "primaryNavigationCollapseMode": "icon",
      "primaryNavigationRailToggle": true
    },
    "mobile": {
      "desktopSidebarRequired": false,
      "navigationBehavior": "offcanvas-drawer",
      "allowedPatterns": [
        "drawer",
        "bottom-navigation",
        "compact-menu"
      ],
      "breakpoint": "900px",
      "drawerWidth": "min(19rem, calc(100vw - 3rem))"
    },
    "navigationItem": {
      "minHeight": "2.55rem",
      "iconSize": "1.15rem",
      "activeIndicatorWidth": "2px",
      "iconGrammar": "Lucide"
    },
    "utilityBar": {
      "height": "3.5rem",
      "role": "page-context-session-family-utilities",
      "breadcrumb": "optional",
      "familyMarkSeparator": "optional-neutral-divider"
    },
    "workspace": {
      "contentMaxWidth": "1240px",
      "desktopPadding": "36px 40px 64px",
      "mediumPadding": "28px 28px 56px",
      "narrowPadding": "20px 16px 48px"
    }
  },
  "applicationUI": {
    "version": "1.0.0",
    "principles": {
      "functionalCasing": "sentence-case",
      "accentUsage": "semantic-emphasis-only",
      "iconGrammar": "Lucide",
      "brandTypographyBoundary": "Display identity typography is distinct from dense application typography."
    },
    "color": {
      "background": "#000000",
      "surface": "#0A0A0B",
      "surfaceRaised": "#111113",
      "surfaceStrong": "#18181B",
      "overlay": "#0E0E10",
      "hover": "rgba(255, 255, 255, 0.035)",
      "hoverStrong": "rgba(255, 255, 255, 0.06)",
      "border": "#1C1C1F",
      "borderRaised": "#27272A",
      "borderStrong": "#3F3F46",
      "textPrimary": "#F4F4F5",
      "textSecondary": "#D0D0D0",
      "textMuted": "#A0A0A0",
      "textQuiet": "#6B6B72",
      "danger": "#F26D6D",
      "warning": "#F0A53A",
      "caution": "#E2C044",
      "success": "#3ECF8E"
    },
    "typography": {
      "pageTitle": {
        "fontSize": "24px",
        "fontWeight": 650,
        "lineHeight": 1.15,
        "letterSpacing": "-0.02em"
      },
      "sectionTitle": {
        "fontSize": "14px",
        "fontWeight": 600,
        "lineHeight": 1.3,
        "letterSpacing": "-0.005em"
      },
      "body": {
        "fontSize": "13px",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0"
      },
      "supporting": {
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0"
      },
      "metadata": {
        "fontSize": "11px",
        "fontWeight": 600,
        "lineHeight": 1.2,
        "letterSpacing": "0"
      },
      "kicker": {
        "fontSize": "11px",
        "fontWeight": 600,
        "lineHeight": 1.2,
        "letterSpacing": "0.14em",
        "textTransform": "uppercase"
      }
    },
    "layout": {
      "contentMaxWidth": "1240px",
      "readingMaxWidth": "880px",
      "utilityBarHeight": "3.5rem",
      "workspacePaddingDesktop": "36px 40px 64px",
      "workspacePaddingMedium": "28px 28px 56px",
      "workspacePaddingNarrow": "20px 16px 48px",
      "mediumBreakpoint": "1100px",
      "narrowBreakpoint": "900px"
    },
    "controls": {
      "fieldMinHeight": "36px",
      "buttonMinHeight": "34px",
      "iconButtonSize": "32px",
      "modalMaxWidth": "640px",
      "modalMaxHeight": "min(86vh, 860px)",
      "modalRadius": "14px",
      "overlayShadow": "0 24px 64px rgba(0, 0, 0, 0.62), 0 0 0 1px rgba(255, 255, 255, 0.02)"
    },
    "motion": {
      "interaction": "120ms",
      "dialog": "180ms",
      "easing": "cubic-bezier(0.2, 0, 0, 1)"
    }
  }
}
